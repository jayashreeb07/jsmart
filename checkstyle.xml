<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
  "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <module name="TreeWalker">
    <module name="NeedBraces"/>
    <module name="AvoidStarImport"/>
    <module name="UnusedImports"/>
    <module name="HiddenField"><property name="ignoreConstructorParameter" value="true"/></module>
    <module name="MagicNumber"><property name="ignoreNumbers" value="-1,0,1,2,10,100,200,201,400,401,403,404,409,500"/></module>
    <module name="Indentation"><property name="basicOffset" value="2"/><property name="caseIndent" value="2"/></module>
  </module>
  <module name="LineLength"><property name="max" value="140"/></module>
  <module name="FileTabCharacter"/>
</module>
